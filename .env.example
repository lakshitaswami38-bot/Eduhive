# EduHive Environment Configuration Template
# Copy this file to .env and replace with your local credentials

SECRET_Key=
DATABASE_URL=mysql+pymysql://root:Password@localhost:3306/eduhive

# Optional SMTP Mail Configuration (leave empty to print emails to terminal)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@eduhive.in
